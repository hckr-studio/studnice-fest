{% extends "layouts/master.njk" %}
{#
  Rozcestník galerií. Každý ročník (složka src/cloudinary/gallery/<rok>/)
  má upoutávku s pár fotkami a odkaz na vlastní stránku /galerie/<rok>/.
#}
{% set title = "Fotogalerie" %}
{% set years = galleries(collections.images) %}
{% set teaserCount = 5 %}

{% block head_stylesheets %}
  <style>
    .gallery-head p {
      max-width: 65ch;
      margin-block: 0.5em 0;
    }

    .gallery-years {
      display: grid;
      gap: 2.5em;
    }

    .gallery-teaser {
      header {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0.25em 1em;
        margin-block-end: 0.75em;
      }

      h3 {
        margin: 0;

        a {
          color: inherit;
          text-decoration: none;
        }
      }

      header > a {
        font: 700 1.05em var(--accented-font);
        color: var(--accent-color-darker);
      }
    }

    .gallery-teaser__photos {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      grid-template-rows: 1fr 1fr;
      gap: clamp(0.35rem, 1.2vw, 0.75rem);
      aspect-ratio: 2.2;

      a {
        position: relative;
        display: block;
        overflow: hidden;
        border-radius: calc(var(--corner-radius) / 2);
        background: var(--blue-background-color);

        &:first-child {
          grid-row: span 2;
        }
      }

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 300ms ease;
      }

      a:hover img,
      a:focus-visible img {
        scale: 1.04;
      }

      .gallery-teaser__more {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: rgb(0 0 0 / 45%);
        color: #fff;
        font: 700 clamp(1rem, 0.8rem + 1vw, 1.5rem) var(--accented-font);
      }

      .gallery-teaser__more[hidden] {
        display: none;
      }
    }

    main {
      row-gap: 2em;
    }

    @media (max-width: 480px) {
      .gallery-teaser__photos {
        grid-template-columns: 1fr 1fr;
        grid-template-rows: auto;
        aspect-ratio: auto;

        a {
          aspect-ratio: 4 / 3;

          &:first-child {
            grid-row: auto;
            grid-column: span 2;
            aspect-ratio: 16 / 9;
          }

          &:nth-child(n + 4) {
            display: none;
          }

          &:nth-child(3) .gallery-teaser__more {
            display: grid;
          }
        }
      }
    }
  </style>
{% endblock %}

{% block content %}
  <main>
    <header class="gallery-head">
      <h2>Fotogalerie</h2>
      <p>Fotky z&nbsp;posledních ročníků Studnice Festu. Vyberte ročník a&nbsp;prohlédněte si celou galerii.</p>
    </header>

    <div class="gallery-years">
      {% for g in years %}
        {% set url = "/galerie/" ~ g.year ~ "/" %}
        {% set count = g.photos | length %}
        <section class="gallery-teaser" id="rok-{{ g.year }}">
          <header>
            <h3><a href="{{ url }}">Studnice Fest {{ g.year }}</a></h3>
            <a href="{{ url }}">Všech {{ count }} fotek →</a>
          </header>
          <div class="gallery-teaser__photos">
            {% for image in g.photos.slice(0, teaserCount) %}
              <a href="{{ url }}" {% if not loop.first %}tabindex="-1" aria-hidden="true"{% else %}aria-label="Fotogalerie {{ g.year }}"{% endif %}>
                <img alt="" loading="lazy"
                     width="{{ image.width }}" height="{{ image.height }}"
                     style="{% if image.metadata.lqip %}--lqip:{{ image.metadata.lqip }}{% endif %}"
                     sizes="{{ '(min-width: 960px) 420px, 92vw' if loop.first else '(min-width: 960px) 210px, 46vw' }}"
                     src="{{ image.public_id | cloudinaryUrl({ crop: 'fill', width: 900 if loop.first else 450, ar: 1.333 }) }}">
                {% if loop.last and count > teaserCount %}
                  <span class="gallery-teaser__more">+{{ count - teaserCount }}</span>
                {% elif loop.index == 3 and count > 3 %}
                  <span class="gallery-teaser__more" hidden>+{{ count - 3 }}</span>
                {% endif %}
              </a>
            {% endfor %}
          </div>
        </section>
      {% else %}
        <p>Fotky zatím nejsou k&nbsp;dispozici.</p>
      {% endfor %}
    </div>
  </main>
{% endblock %}
