{% extends "layouts/master.njk" %}
{#
  Stránka galerie jednoho ročníku. Stránky src/html/galerie/<rok>/index.njk
  generuje config/gallery-registry.mjs a nastaví v nich `year`.
#}
{% set g = gallery(collections.images, year) %}
{% set title = "Fotogalerie Studnice Fest " ~ year %}
{% set newer = g.newer if g else null %}
{% set older = g.older if g else null %}

{% block head_stylesheets %}
  <style>
    /* Bílý podklad jako u obsahových částí webu */
    .gallery-panel {
      background-color: var(--background-color);
      border-radius: var(--corner-radius);
      padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    }

    .gallery-head {
      margin-block-end: 1.25em;

      h2 {
        margin: 0;
      }

      p {
        margin: 0.35em 0 0;
      }
    }

    .gallery-back {
      font: 700 1em var(--accented-font);
      color: var(--accent-color-darker);
    }

    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(0.35rem, 1.2vw, 0.75rem);
    }

    @media (min-width: 600px) {
      .gallery-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (min-width: 960px) {
      .gallery-grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .gallery-item {
      appearance: none;
      border: 0;
      border-radius: calc(var(--corner-radius) / 2);
      background: var(--blue-background-color);
      padding: 0;
      overflow: hidden;
      cursor: zoom-in;
      aspect-ratio: 4 / 3;

      img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 180ms ease;
      }

      &:hover img,
      &:focus-visible img {
        scale: 1.035;
      }
    }

    .gallery-item:focus-visible,
    .lightbox button:focus-visible {
      outline: 3px solid var(--accent3-color);
      outline-offset: 3px;
    }

    .gallery-pager {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5em 1em;
      margin: 1.5em 0 0;
      font: 700 1.05em var(--accented-font);

      a {
        color: var(--accent-color-darker);
      }
    }

    /* Prohlížeč: vodorovný pás fotek se snapováním – swipe jede za prstem */
    .lightbox {
      width: 100vw;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      border: 0;
      padding: 0;
      background: #000;
      color: #fff;
      overflow: hidden;
    }

    .lightbox::backdrop {
      background: #000;
    }

    .lightbox__track {
      display: flex;
      height: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      overscroll-behavior: contain;
      scrollbar-width: none;

      &::-webkit-scrollbar {
        display: none;
      }
    }

    .lightbox__slide {
      position: relative;
      flex: 0 0 100%;
      height: 100%;
      scroll-snap-align: center;
      scroll-snap-stop: always;

      /* Fotka se vždy celá vejde do okna (na výšku i na šířku) – bez ořezu */
      img {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        user-select: none;
        -webkit-user-drag: none;
      }
    }

    .lightbox button {
      position: fixed;
      z-index: 2;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 0;
      border-radius: 999px;
      background: rgb(0 0 0 / 55%);
      color: #fff;
      font: 700 1.8rem/1 var(--main-font);
      cursor: pointer;
    }

    .lightbox__close {
      top: max(1rem, env(safe-area-inset-top));
      right: 1rem;
    }

    .lightbox__prev,
    .lightbox__next {
      top: 50%;
      translate: 0 -50%;
    }

    .lightbox__prev { left: 1rem; }
    .lightbox__next { right: 1rem; }

    /* Na dotykových zařízeních jen swipe, bez šipek po stranách */
    @media (pointer: coarse) {
      .lightbox__prev,
      .lightbox__next {
        display: none !important;
      }
    }

    .lightbox__counter {
      position: fixed;
      bottom: max(1rem, env(safe-area-inset-bottom));
      left: 50%;
      translate: -50% 0;
      margin: 0;
      padding: 0.35rem 0.8rem;
      border-radius: 999px;
      background: rgb(0 0 0 / 55%);
      font-family: var(--accented-font);
      font-weight: 700;
    }
  </style>
{% endblock %}

{% block content %}
  <main>
    <div class="gallery-panel">
      <header class="gallery-head">
        <h2>Fotogalerie Studnice Fest {{ year }}</h2>
        <p><a class="gallery-back" href="/historie/#studnice-fest-{{ year }}">Historie ročníku {{ year }} →</a></p>
      </header>

      {% if g %}
        <div class="gallery-grid" data-gallery>
          {% for image in g.photos %}
            <button class="gallery-item" type="button"
                    data-src-m="{{ image.public_id | cloudinaryUrl({ width: 1280 }) }}"
                    data-src-l="{{ image.public_id | cloudinaryUrl({ width: 2000 }) }}"
                    aria-label="Otevřít fotografii {{ loop.index }} z {{ g.photos | length }}">
              <img alt="" width="{{ image.width }}" height="{{ image.height }}" loading="lazy" decoding="async"
                   style="{% if image.metadata.lqip %}--lqip:{{ image.metadata.lqip }}{% endif %}"
                   src="{{ image.public_id | cloudinaryUrl({ crop: 'fill', width: 480, ar: 1.333 }) }}">
            </button>
          {% endfor %}
        </div>
      {% endif %}

      <p class="gallery-pager">
        {% if older %}<a href="/galerie/{{ older }}/">← {{ older }}</a>{% else %}<span></span>{% endif %}
        <a href="/galerie/">Všechny ročníky</a>
        {% if newer %}<a href="/galerie/{{ newer }}/">{{ newer }} →</a>{% else %}<span></span>{% endif %}
      </p>
    </div>
  </main>

  <dialog class="lightbox" data-lightbox aria-label="Prohlížeč fotografií">
    <div class="lightbox__track"></div>
    <button class="lightbox__close" type="button" aria-label="Zavřít">×</button>
    <button class="lightbox__prev" type="button" aria-label="Předchozí fotografie">‹</button>
    <button class="lightbox__next" type="button" aria-label="Následující fotografie">›</button>
    <p class="lightbox__counter" aria-live="polite"></p>
  </dialog>
{% endblock %}

{% block scripts %}
  <script type="module">
    const items = [...document.querySelectorAll("[data-gallery] .gallery-item")];
    const lightbox = document.querySelector("[data-lightbox]");
    const track = lightbox.querySelector(".lightbox__track");
    const counter = lightbox.querySelector(".lightbox__counter");
    const PRELOAD = 2; // kolik fotek dopředu/dozadu načíst
    let current = 0;

    // Slidy vytvoříme jednou, obrázky se načítají jen kolem aktuální fotky.
    const slides = items.map(() => {
      const slide = document.createElement("div");
      slide.className = "lightbox__slide";
      const img = document.createElement("img");
      img.alt = "";
      img.decoding = "async";
      slide.append(img);
      track.append(slide);
      return slide;
    });

    // Velikost podle displeje: telefony 1280 px, velké obrazovky 2000 px.
    const sizeKey = () =>
      Math.max(innerWidth, innerHeight) * devicePixelRatio > 1600 ? "srcL" : "srcM";

    function load(index) {
      const img = slides[index]?.firstChild;
      if (img && !img.src) img.src = items[index].dataset[sizeKey()];
    }

    function update(index) {
      current = index;
      counter.textContent = `${index + 1} / ${items.length}`;
      for (let i = index - PRELOAD; i <= index + PRELOAD; i++) load(i);
    }

    function go(index, smooth = true) {
      const i = Math.max(0, Math.min(items.length - 1, index));
      track.scrollTo({ left: i * track.clientWidth, behavior: smooth ? "smooth" : "instant" });
      update(i);
    }

    let scrollTimer;
    track.addEventListener("scroll", () => {
      const i = Math.round(track.scrollLeft / track.clientWidth);
      if (i !== current) update(i);
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => update(Math.round(track.scrollLeft / track.clientWidth)), 120);
    }, { passive: true });

    items.forEach((item, index) => item.addEventListener("click", () => {
      lightbox.showModal();
      update(index);
      requestAnimationFrame(() => go(index, false));
    }));

    lightbox.querySelector(".lightbox__close").addEventListener("click", () => lightbox.close());
    lightbox.querySelector(".lightbox__prev").addEventListener("click", () => go(current - 1));
    lightbox.querySelector(".lightbox__next").addEventListener("click", () => go(current + 1));

    lightbox.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") { event.preventDefault(); go(current - 1); }
      if (event.key === "ArrowRight") { event.preventDefault(); go(current + 1); }
    });

    // Klik vedle fotky zavře prohlížeč (jen myší, ne po swipu).
    track.addEventListener("click", (event) => {
      if (event.target.classList.contains("lightbox__slide")) lightbox.close();
      // klik do prázdného místa vedle fotky (img je přes celý slide, fotka uvnitř „contain“)
      const img = event.target.closest(".lightbox__slide img");
      if (img && img.naturalWidth) {
        const r = img.getBoundingClientRect();
        const scale = Math.min(r.width / img.naturalWidth, r.height / img.naturalHeight);
        const w = img.naturalWidth * scale, h = img.naturalHeight * scale;
        const x = event.clientX - r.left - (r.width - w) / 2, y = event.clientY - r.top - (r.height - h) / 2;
        if (x < 0 || y < 0 || x > w || y > h) lightbox.close();
      }
    });

    addEventListener("resize", () => {
      if (lightbox.open) go(current, false);
    });

    lightbox.addEventListener("close", () => {
      items[current]?.focus();
    });
  </script>
{% endblock %}
