{% extends "layouts/master.njk" %}
{% from "macros/social-icon.njk" import socialIcon %}
{#
  Detail kapely. Stránky src/html/kapely/<slug>/index.njk generuje
  config/artist-registry.mjs a nastaví v nich `slug`.

  Data bere ze src/data/artists/<slug>.md – vše kromě jména a fotky je volitelné:
    ---
    image: dub-fx.jpg
    genre: beatbox, dub          # štítek pod jménem
    origin: Austrálie            # odkud kapela je
    years: [2018, 2022]          # starší ročníky, které nejsou v history (global.mjs)
    videos: [sK-eE2CCUv4, …]     # YouTube ID videí (1–2; staré pole video: funguje taky)
    spotify: https://open.spotify.com/artist/…   # interpret, album, skladba nebo playlist
    links:
      web: https://…
      instagram: https://…
      facebook: https://…
      spotify: https://…
      youtube: https://…
      bandcamp: https://…
    ---
    # Jméno kapely
    Popis kapely v markdownu…
#}
{% set artist = collections.artists[slug] %}
{% set image = collections.images["artists/" + artist.image] if artist.image else null %}
{% set title = artist.title | striptags | replace("&amp;", "&") %}

{# Ročníky: z historie (global.mjs history, i rozsahy „2008–2012“), z aktuálního ročníku a z „years“ v .md #}
{% set playedYears = [] %}
{% for year, items in history %}
  {% for item in items %}
    {% if (item.slug or item) == slug and not (year | string) in playedYears %}
      {% set playedYears = (playedYears.push(year | string), playedYears) %}
    {% endif %}
  {% endfor %}
{% endfor %}
{% for year in artist.years or [] %}
  {% if not (year | string) in playedYears %}{% set playedYears = (playedYears.push(year | string), playedYears) %}{% endif %}
{% endfor %}
{% set playedYears = playedYears | sort(true) %}
{% set upcoming = slug in event.artists %}
{# Spotify: odkaz na interpreta, album, skladbu nebo playlist (nebo jen ID interpreta) #}
{% set sp = (artist.spotify or (artist.links.spotify if artist.links else "") or "") | string %}
{% set spotifyPath = "" %}
{% if "open.spotify.com/" in sp %}
  {% set spotifyPath = sp.split("open.spotify.com/")[1].split("?")[0] %}
  {% if spotifyPath.startsWith("intl-") %}{% set spotifyPath = spotifyPath.split("/").slice(1).join("/") %}{% endif %}
  {% if spotifyPath.startsWith("embed/") %}{% set spotifyPath = spotifyPath.slice(6) %}{% endif %}
{% elif sp %}
  {% set spotifyPath = "artist/" ~ sp %}
{% endif %}
{% set upcomingYear = event.startDate.getFullYear() %}
{% set videos = artist.videos or ([artist.video] if artist.video else []) %}

{# Odkazy na sítě: z „links“ v .md, Spotify doplní z profilu interpreta #}
{% set socials = [] %}
{% for key, url in artist.links or {} %}
  {% set socials = (socials.push({ key: key, url: url }), socials) %}
{% endfor %}
{% if spotifyPath.startsWith("artist/") and not (artist.links and artist.links.spotify) %}
  {% set socials = (socials.push({ key: "spotify", url: "https://open.spotify.com/" ~ spotifyPath }), socials) %}
{% endif %}

{# Další kapely: z nejnovějšího ročníku, kde kapela hrála (nebo z chystaného) #}
{% set relatedSource = event.artists if upcoming else (history[playedYears[0]] if playedYears.length else []) %}
{% set related = [] %}
{% for item in relatedSource %}
  {% set s = item.slug or item %}
  {% set a = collections.artists[s] %}
  {% if s != slug and a and a.image and s in artistPages and related.length < 6 %}
    {% set related = (related.push(a), related) %}
  {% endif %}
{% endfor %}

{% set linkLabels = {
  web: "Web",
  instagram: "Instagram",
  facebook: "Facebook",
  spotify: "Spotify",
  youtube: "YouTube",
  bandcamp: "Bandcamp",
  soundcloud: "SoundCloud",
  tiktok: "TikTok"
} %}

{% block head_stylesheets %}
  <style>
    main {
      row-gap: 2em;
    }

    .artist-back {
      margin: 0 0 0.75em;
      font: 700 1em var(--accented-font);

      a {
        color: var(--accent-color-darker);
      }
    }

    .artist {
      display: grid;
      gap: clamp(1rem, 0.5rem + 2vw, 2rem);
      background-color: var(--background-color);
      border-radius: var(--corner-radius);
      padding: clamp(1rem, 0.5rem + 2vw, 2rem);

      @media screen and (min-width: 801px) {
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        align-items: start;
      }
    }

    .artist__photo {
      margin: 0;

      /* mobil: fotka přes celou šířku karty nahoře */
      @media screen and (max-width: 800px) {
        margin: calc(-1 * clamp(1rem, 0.5rem + 2vw, 2rem)) calc(-1 * clamp(1rem, 0.5rem + 2vw, 2rem)) 0;

        img {
          aspect-ratio: 5 / 4;
          border-radius: var(--corner-radius) var(--corner-radius) 0 0;
        }
      }

      img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border-radius: var(--corner-radius);
        background: var(--blue-background-color);
      }

      @media screen and (min-width: 801px) {
        position: sticky;
        top: 6em;
      }
    }

    .artist__head {
      h2 {
        margin: 0;
        font-size: clamp(2rem, 1.4rem + 2.5vw, 3.25rem);
        line-height: 1.05;
        text-wrap: balance;
      }
    }

    .artist__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em;
      margin: 0.75em 0 0;
      padding: 0;
      list-style: none;

      li {
        padding: 0.2em 0.75em;
        border-radius: 999px;
        background-color: var(--blue-background-color);
        font-weight: 600;
        font-size: 0.95em;
      }
    }

    .artist__upcoming {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      padding: 0.5em 1em;
      border-radius: var(--corner-radius);
      background-color: var(--accent-color-strong);
      color: #fff;
      font: 700 1.05em var(--accented-font);
      text-decoration: none;

      &:hover,
      &:focus-visible {
        background-color: var(--accent-color-darker);
      }
    }

    .artist__tickets {
      display: grid;
      justify-items: start;
      gap: 0.6em;
      margin: 1.75em 0 0;
      padding-block-start: 1.25em;
      border-block-start: 1px solid var(--blue-background-color);

      span {
        font: 700 1.1em var(--accented-font);
      }
    }

    .artist__social {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5em;
      margin: 1em 0 0;
      padding: 0;
      list-style: none;

      a {
        display: grid;
        place-items: center;
        width: 2.6rem;
        height: 2.6rem;
        border-radius: 50%;
        background-color: var(--dark-blue-background-color);
        color: #fff;
        font: 700 1.1rem var(--accented-font);
        text-decoration: none;
        transition: background-color 200ms;

        &:hover,
        &:focus-visible {
          background-color: var(--accent-color-darker);
        }
      }

      svg {
        width: 1.3rem;
        height: 1.3rem;
      }
    }

    .artist__years {
      margin-block-start: 1.25em;

      h3 {
        margin: 0 0 0.4em;
        font: 700 1em var(--accented-font);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--accent-color-darker);
      }

      ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4em;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      a {
        display: block;
        padding: 0.3em 0.85em;
        border: 2px solid var(--accent-color);
        border-radius: 999px;
        color: var(--accent-color-darker);
        font: 700 1em var(--accented-font);
        text-decoration: none;

        &:hover,
        &:focus-visible {
          background-color: var(--accent-color-strong);
          color: #fff;
        }
      }
    }

    .artist__body {
      margin-block-start: 1.25em;

      > :first-child {
        margin-block-start: 0;
      }
    }

    .artist__video {
      margin-block-start: 1.5em;
      border-radius: var(--corner-radius);
      overflow: hidden;
    }

    .artist__spotify {
      display: block;
      width: 100%;
      height: 352px;
      margin-block-start: 1.5em;
      border: 0;
      border-radius: 12px;
    }

    .artist__spotify--track {
      height: 152px;
    }

    .artist-related {
      background-color: var(--background-color);
      border-radius: var(--corner-radius);
      padding: clamp(1rem, 0.5rem + 2vw, 2rem);

      h3 {
        margin: 0 0 0.75em;
      }

      ul {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));

        @media screen and (min-width: 801px) {
          grid-template-columns: repeat(6, minmax(0, 1fr));
        }
        gap: 0.6em;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      a {
        position: relative;
        display: grid;
        grid-template: minmax(0, 1fr) / minmax(0, 1fr);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: var(--corner-radius);
        background: var(--dark-blue-background-color);
        text-decoration: none;

        img {
          grid-area: 1/1;
          width: 100%;
          height: 100%;
          object-fit: cover;
          transition: scale 400ms ease;
        }

        span {
          grid-area: 1/1;
          place-self: end stretch;
          z-index: 1;
          padding: 1.5em 0.4em 0.45em;
          color: #fff;
          font: 700 clamp(0.7rem, 0.6rem + 0.3vw, 0.85rem)/1.15 var(--accented-font);
          text-align: center;
          text-transform: uppercase;
          text-wrap: balance;
          background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.6));
        }

        &:hover img,
        &:focus-visible img {
          scale: 1.06;
        }
      }
    }
  </style>
{% endblock %}

{% block content %}
  <main>
    <article class="artist">
      {% if image %}
        <figure class="artist__photo">
          <img alt="{{ title }}" width="600" height="600"
               {% if image.metadata.lqip %}style="--lqip:{{ image.metadata.lqip }}"{% endif %}
               sizes="(min-width: 801px) 520px, 100vw"
               src="{{ image.public_id | cloudinaryUrl(ar=1, crop="fill", gravity="auto", width=1000) }}">
        </figure>
      {% endif %}

      <div class="artist__content">
        <p class="artist-back">
          <a href="{{ '/#vystoupi' if upcoming else '/historie/' }}">← {{ "Zpět na Kdo vystoupí" if upcoming else "Zpět na Historii" }}</a>
        </p>

        <header class="artist__head">
          <h2>{{ artist.title | safe }}</h2>
          {% if artist.genre or artist.origin %}
            <ul class="artist__meta">
              {% if artist.genre %}<li>{{ artist.genre }}</li>{% endif %}
              {% if artist.origin %}<li>{{ artist.origin }}</li>{% endif %}
            </ul>
          {% endif %}
        </header>

        {% if socials.length %}
          <ul class="artist__social">
            {% for s in socials %}
              <li><a href="{{ s.url }}" rel="noopener" target="_blank" title="{{ linkLabels[s.key] or s.key }}"
                     aria-label="{{ title }} – {{ linkLabels[s.key] or s.key }}">{{ socialIcon(s.key) }}</a></li>
            {% endfor %}
          </ul>
        {% endif %}

        {% if playedYears.length %}
          <section class="artist__years">
            <h3>Na Studnici{% if playedYears.length > 1 %} <small>{{ playedYears.length }}×</small>{% endif %}</h3>
            <ul>
              {% for year in playedYears %}
                {% set y = year.slice(0, 4) | int %}
                <li><a href="/historie/#studnice-fest-{{ '20042012' if (y >= 2004 and y <= 2012) else year }}">{{ year }}</a></li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        {% if artist.body %}
          <div class="artist__body">{{ artist.body | safe }}</div>
        {% endif %}

        {% if spotifyPath %}
          <iframe class="artist__spotify{% if spotifyPath.startsWith("track/") %} artist__spotify--track{% endif %}" title="{{ title }} na Spotify" loading="lazy"
                  src="https://open.spotify.com/embed/{{ spotifyPath }}?utm_source=generator&amp;theme=0"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
        {% endif %}

        {% for id in videos %}
          <div class="artist__video">
            <lite-youtube videoid="{{ id }}" params="hl=cs&amp;modestbranding=1"
                          title="{{ title }}" class="responsive"></lite-youtube>
          </div>
        {% endfor %}

        {% if upcoming %}
          <p class="artist__tickets">
            <span>Nenechte si ujít {{ title }} živě na Studnici {{ upcomingYear }}!</span>
            <a class="artist__upcoming" href="/#vstupenky">Chci vstupenky →</a>
          </p>
        {% endif %}
      </div>
    </article>

    {% if related.length %}
      <section class="artist-related">
        <h3>{{ "Na Studnici " ~ upcomingYear ~ " dále hrají" if upcoming else "Na Studnici " ~ playedYears[0] ~ " hráli také" }}</h3>
        <ul>
          {% for a in related %}
            {% set img = collections.images["artists/" + a.image] %}
            <li>
              <a href="/kapely/{{ a.slug }}/">
                <img alt="" width="180" height="180" loading="lazy"
                     {% if img.metadata.lqip %}style="--lqip:{{ img.metadata.lqip }}"{% endif %}
                     src="{{ img.public_id | cloudinaryUrl(ar=1, crop="fill", gravity="auto", width=360) }}">
                <span>{{ a.title | safe }}</span>
              </a>
            </li>
          {% endfor %}
        </ul>
      </section>
    {% endif %}
  </main>
{% endblock %}

{% block scripts %}
  {% if videos.length %}
    <script type="module" src="{{ "kapela.js" | assetUrl("esm") }}"></script>
  {% endif %}
{% endblock %}
