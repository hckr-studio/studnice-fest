{% extends 'layouts/master.njk' %}
{% set title = "Historie" %}

{% set bgImage = collections.images["history-bg.jpg"]  %}

{% block head_preconnect %}
{% endblock %}

{% block head_stylesheets %}
  <style>
    .main {
      display: grid;
      grid-template: "aside" "article";
      gap: 1em;
      align-items: start;
    }

    .main aside {
      grid-area: aside;
      min-width: clamp(8rem, 2.6667rem + 17.7778vw, 12rem);
      font: clamp(1rem, 0.6667rem + 1.1111vw, 1.25rem) var(--accented-font);
    }

    .main article {
      background-color: var(--background-color);
      border-radius: var(--corner-radius);
      padding-inline: 1em;
    }

    @media screen and (min-width: 481px) {
      .main {
        grid-template: "aside article";
        grid-template-columns: clamp(8rem, 2.6667rem + 17.7778vw, 12rem) 1fr;
      }

      .main aside {
        position: sticky;
        top: 4em;
      }
    }

    .main aside ol {
      list-style-type: none;
      margin: 0.8em 0 0;
      padding: 0;
    }

    .main aside ol li {
      padding: 0.3em 0;
      text-wrap: balance;
    }

    .main aside a[aria-current="true"] {
      color: var(--accent-color-darker);
      text-decoration-thickness: 2px;
    }

    /* Mobil: roky jako připnutý vodorovný pás „pilulek“ místo dlouhého seznamu */
    @media screen and (max-width: 480px) {
      .main aside {
        position: sticky;
        top: calc(var(--header-height, 3.5rem) - 1px);
        z-index: 10;
        min-width: 0;
        margin-inline: -0.25em;
        padding: 0.4em 0.25em;
        font-size: 1rem;
        background-color: color-mix(in srgb, var(--background-color), transparent 8%);
        backdrop-filter: blur(4px);
        border-radius: var(--corner-radius);
        box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
      }

      .main aside ol {
        display: flex;
        gap: 0.4em;
        margin: 0;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scroll-snap-type: x proximity;
        scrollbar-width: none;

        &::-webkit-scrollbar {
          display: none;
        }
      }

      .main aside ol li {
        flex: none;
        padding: 0;
        scroll-snap-align: center;
      }

      .main aside a {
        display: block;
        padding: 0.35em 0.85em;
        border: 2px solid var(--accent-color);
        border-radius: 999px;
        color: var(--accent-color-darker);
        text-decoration: none;
        white-space: nowrap;
        transition: background-color 200ms, color 200ms;
      }

      .main aside a[aria-current="true"] {
        background-color: var(--accent-color);
        color: #fff;
      }

      /* skok na ročník nesmí skončit pod hlavičkou a pásem roků */
      .main article h3[id] {
        scroll-margin-block-start: calc(var(--header-height, 3.5rem) + 4rem);
      }
    }

    main > hgroup {
      color: #fff;
      grid-column: wide;
      display: flex;
      flex-flow: column;
      justify-content: flex-end;
      aspect-ratio: 1.91;
      padding-inline: 2em;
      border-radius: var(--corner-radius);
      position: relative;
    }

    main > hgroup::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--corner-radius);
      background-image: linear-gradient(to top, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0.0) 33%),
      url("{{ bgImage.public_id | cloudinaryUrl() }}");
      background-repeat: no-repeat;
      background-size: cover;
    }

    main > hgroup > * {
      z-index: 2;
    }

    main > hgroup > h2 {
      margin-block: 0;
    }

    /* Mobil: fotka zůstane volná, přes ni jen nadpis; úvodní text pod ní */
    @media screen and (max-width: 480px) {
      main > hgroup {
        aspect-ratio: auto;
        justify-content: flex-start;
        padding: 0;
        color: var(--text-color);
        background: var(--background-color) none !important;
        overflow: hidden;
      }

      main > hgroup::before {
        position: static;
        aspect-ratio: 1.91;
        border-radius: var(--corner-radius) var(--corner-radius) 0 0;
        background-image: linear-gradient(to top, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.0) 45%),
        url("{{ bgImage.public_id | cloudinaryUrl() }}");
      }

      main > hgroup > h2 {
        margin-block-start: -1.45em;
        padding-inline: 0.75rem;
        color: #fff;
        font-size: 1.9rem;
        line-height: 1.3;
      }

      main > hgroup > p {
        margin: 0;
        padding: 0.85rem 1rem 1rem;
        font-size: 0.95rem;
        line-height: 1.5;
      }
    }

    /* Výraznější oddělení jednotlivých ročníků */
    .main article h3[id] {
      margin-block: 2.25em 0.5em;
      padding-block-start: 1.25em;
      border-block-start: 3px solid color-mix(in srgb, var(--accent-color), transparent 65%);
      font-size: 1.5em;
      color: var(--accent-color-darker);
    }

    .main article h3[id]:first-child {
      margin-block-start: 0.75em;
      padding-block-start: 0;
      border-block-start: 0;
    }

    .main article h3[id]:not(#studnice-fest-20042012) + p {
      display: inline-block;
      margin-block: 0 0.5em;
      padding: 0.2em 0.75em;
      border-radius: 999px;
      background-color: var(--blue-background-color);
      font-weight: 600;
      font-size: 0.95em;
    }

    /* Kapely ročníku – zmenšená obdoba karet z hlavní stránky */
    .history-bands {
      list-style: none;
      margin: 1em 0 1.25em;
      padding: 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(clamp(5.5rem, 4.5rem + 3vw, 7rem), 1fr));
      gap: 0.5em;
    }

    .history-bands__item {
      margin: 0;
      padding: 0;
      aspect-ratio: 1;
      border-radius: var(--corner-radius);
      overflow: hidden;
      display: grid;
      background-color: var(--dark-blue-background-color);

      &::marker {
        content: none;
      }

      img {
        grid-area: 1/1;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: scale 500ms cubic-bezier(.5, -.25, .75, 1);

        &:hover {
          scale: 1.1;
        }
      }

      span {
        grid-area: 1/1;
        place-self: end stretch;
        z-index: 1;
        padding: 1.5em 0.35em 0.4em;
        font: 700 clamp(0.7rem, 0.6rem + 0.3vw, 0.85rem)/1.15 var(--accented-font);
        text-transform: uppercase;
        text-align: center;
        text-wrap: balance;
        color: #fff;
        text-shadow: 1px 1px #333;
        background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.55) 100%);
        pointer-events: none;
      }
    }

    .history-bands__item > a {
      display: contents;
      text-decoration: none;
    }

    /* Kapely bez fotky – jen jméno na barevné dlaždici */
    .history-bands__item--text {
      background-color: var(--accent-color-darker);

      span {
        place-self: center stretch;
        padding: 0.5em;
        font-size: clamp(0.75rem, 0.65rem + 0.35vw, 0.95rem);
        background: none;
        text-shadow: none;
      }
    }

    /* Starší ročníky: zjednodušený výpis vystupujících jako štítky */
    .history-list {
      margin-block: 1.25em 1.5em;

      h4 {
        margin: 0 0 0.5em;
        font: 700 1.1em var(--accented-font);
      }
    }

    .history-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em;
      margin: 0;
      padding: 0;
      list-style: none;

      li {
        margin: 0;
        padding: 0;

        &::marker {
          content: none;
        }
      }

      span,
      a {
        display: block;
        padding: 0.3em 0.8em;
        border-radius: 999px;
        font-size: 0.95em;
        line-height: 1.3;
      }

      span {
        background-color: var(--blue-background-color);
      }

      a {
        background-color: var(--accent-color);
        color: #fff;
        font-weight: 600;
        text-decoration: none;

        &::after {
          content: " →";
        }

        &:hover,
        &:focus-visible {
          background-color: var(--accent-color-darker);
        }
      }
    }

    .history-older {
      margin-block: 1.5em;
      padding: 1em 1.25em;
      border-radius: var(--corner-radius);
      background-color: var(--light-blue-background-color);

      .history-older__title {
        margin: 0 0 0.25em;
        font: 700 1.2em var(--accented-font);

        small {
          font: 400 0.75em var(--main-font);
        }
      }

      .history-list {
        margin-block: 0.75em;
      }

      .history-list h4 {
        font-size: 1em;
        color: var(--accent-color-darker);
      }
    }

    /* Všichni vystupující – sbalené na pár řádků, plynulé rozbalení */
    .history-lineup {
      margin-block: 1.5em 2em;

      h4 {
        margin: 0 0 0.25em;
        font: 700 1.1em var(--accented-font);
      }

      .history-bands {
        margin: 0;
      }
    }

    .history-lineup__clip {
      position: relative;
      margin-block-start: 0.5em;
      overflow: hidden;
      transition: max-height 700ms cubic-bezier(.4, 0, .2, 1);

      &::after {
        content: "";
        position: absolute;
        inset: auto 0 0;
        height: 70%;
        background: linear-gradient(to bottom, transparent, var(--background-color));
        pointer-events: none;
        opacity: 0;
        transition: opacity 500ms ease;
      }
    }

    .history-lineup.is-collapsible:not(.is-open) .history-lineup__clip::after {
      opacity: 1;
    }

    .history-lineup__toggle {
      display: block;
      margin: 0.75em auto 0;
      padding: 0.45em 1.2em;
      font: 700 0.95em var(--accented-font);
      color: var(--accent-color-darker);
      background: transparent;
      border: 2px solid var(--accent-color);
      border-radius: 999px;
      cursor: pointer;
      transition: background-color 200ms, color 200ms;

      &:hover,
      &:focus-visible {
        background-color: var(--accent-color);
        color: #fff;
      }

      &::after {
        content: "▾";
        display: inline-block;
        margin-inline-start: 0.4em;
        transition: rotate 300ms;
      }

      &[aria-expanded="true"]::after {
        rotate: 180deg;
      }

      &[hidden] {
        display: none;
      }
    }
  </style>
{% endblock %}

{% block content %}
  <main>
    <hgroup style="--lqip: {{ bgImage.metadata.lqip }}">
      <h2>Historie</h2>
      <p>Od prvního setkání stovky známých ve Studnicích až po vyprodané ročníky v lese na Cihelce. Připomeňte si příběh festivalu, který už přes dvacet let tvoří kapely, návštěvníci, dobrovolníci a trochu punkový přístup pořadatelů.</p>
    </hgroup>
    <div class="main">
      <article>
        {% markdown "historie/text.md" %}
      </article>
      <aside>
        <nav aria-label="Obsah stránky">
          <ol>
            <li><a href="#studnice-fest-2026">2026</a></li>
            <li><a href="#studnice-fest-2025">2025</a></li>
            <li><a href="#studnice-fest-2024">2024</a></li>
            <li><a href="#studnice-fest-2023">2023</a></li>
            <li><a href="#studnice-fest-2022">2022</a></li>
            <li><a href="#studnice-fest-2021">2021</a></li>
            <li><a href="#studnice-fest-2020">2020</a></li>
            <li><a href="#studnice-fest-2019">2019</a></li>
            <li><a href="#studnice-fest-2018">2018</a></li>
            <li><a href="#studnice-fest-2017">2017</a></li>
            <li><a href="#studnice-fest-20042012">2004–2012</a></li>
            <li><a href="#studnice-fest-2003">2003</a></li>
          </ol>
        </nav>
      </aside>
    </div>
  </main>
{% endblock %}

{% block scripts %}
  <script type="module" src="{{ "historie.js" | assetUrl("esm") }}"></script>
{% endblock %}
